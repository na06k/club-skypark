{
  "name": "club-skypark-backend",
  "version": "1.0.0",
  "description": "Backend API for the Club Skypark hotel management website.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --ignore data src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "data/**"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
