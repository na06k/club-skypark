PORT=3000
# Set NODE_ENV=production on the live server. In production the server REFUSES to start with a weak JWT_SECRET.
# NODE_ENV=production
# Must be 32+ random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-secret-before-production
ADMIN_EMAIL=admin@clubskypark.local
# Used only to create the very first admin account. Use a strong password (not admin123).
ADMIN_PASSWORD=change-this-password
# Extra websites allowed to call the API (comma separated). localhost is allowed automatically in development.
# CORS_ORIGINS=https://www.clubskypark.com,https://pms.clubskypark.com
# Optional: custom location for the data file
# DATA_FILE=

# WhatsApp Business Cloud API for automatic booking confirmations
HOTEL_PHONE_NUMBER=+91 79748 23267
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional: set a Meta-approved template name for business-initiated messages
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
